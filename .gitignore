# Generated build artifacts
/build/*
/generated/*
!/build/.gitkeep

# Common local editor and OS files
.DS_Store
Thumbs.db
*.user
*.workspace
__pycache__/
*.py[cod]

# C# and Visual Studio build artifacts
**/bin/
**/obj/
.vs/

# SQLite transient files created by graphical editors
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
